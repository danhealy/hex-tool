g = get_custom_object

if not g.hasIndex("colors") then g.colors = {}
g.command = ""
g.logsDirty = false
if not g.hasIndex("const") then g.const = {}
if not g.hasIndex("context") then g.context = {}
if not g.hasIndex("database") then g.database = {}
if not g.hasIndex("unhandledRequirements") then g.unhandledRequirements = []
if not g.hasIndex("requirementPatterns") then g.requirementPatterns = []
if not g.hasIndex("defaults") then g.defaults = {}
if not g.hasIndex("enc") then g.enc = {}
if not g.hasIndex("func") then g.func = {}
if not g.hasIndex("fs") then g.fs = {}
if not g.hasIndex("hackshop") then g.hackshop = {}
if not g.hasIndex("rt") then g.rt = {}
if not g.hasIndex("stack") then g.stack = {}
if not g.hasIndex("target") then g.target = {}
if not g.hasIndex("tools") then g.tools = {}
if not g.hasIndex("util") then g.util = {}

import_code("hex/json.src")
import_code("hex/colors.src")
import_code("hex/constants.src")
import_code("hex/functions.src")
import_code("hex/nuke.src")
import_code("hex/extensions.src")
g.registerExtensions
import_code("hex/banner.src")
import_code("hex/prompt.src")
import_code("hex/default-binaries.src")
import_code("hex/encryption.src")
import_code("hex/config.src")

#include "hex/tools.src"

import_code("hex/proxies.src")

import_code("hex/rshell.src")
import_code("hex/mail.src")
import_code("hex/logs.src")

if params.len > 0 then
	if is_valid_ip(params[0]) then
		// Probably do something with this... maybe probe immediately or scan immediately, idk.
	else
		exit(g.l3("Usage: hex [IP Address] {Port}"))
	end if
end if

if params.len > 1 then
	if params[1] isa number and params[1].to_int >= 0 and params[1].to_int <= 65535 then
		// Probably do something with this... maybe scan immediately or hack immediately, idk.
	else
		exit(g.l3("Usage: hex [IP Address] {Port}"))
	end if
end if

// Optional compile-time environment variables injected by Greybel's #envar directive.
// Greybel may inject these as either parsed literals or JSON strings, so parse if needed.
_envarProxies = #envar proxies
if typeof(_envarProxies) == "string" and _envarProxies != "" then
    _envarProxies = g.func.deserialize(_envarProxies)
end if
if typeof(_envarProxies) == "list" then
    g.proxies = _envarProxies
    print(g.const.indent + g.s3("Loaded " + _envarProxies.len + " proxy(s) from environment variable."))
end if

_envarRshell = #envar rshell
if typeof(_envarRshell) == "string" and _envarRshell != "" then
    _envarRshell = g.func.deserialize(_envarRshell)
end if
if typeof(_envarRshell) == "map" and _envarRshell.hasIndex("ip") and _envarRshell.hasIndex("user") and _envarRshell.hasIndex("pass") then
    g.rshellEnv = _envarRshell
    print(g.const.indent + g.s3("Loaded rshell server from environment variable."))
end if

g.func.init
g.func.updateApt
output = g.func.updateLibs
g.func.loadLibs
g.func.loadExploitDb
//g.func.loop_terminal

print(g.func.getBanner)
print(output)

g.func.init_rshell
g.func.initMail
g.func.rt_load

while true
	if g.command == "" then
		input = user_input(g.func.getPrompt, 0, 0, 1)

		if input == "" then
			continue
		end if

		key = input.split(" ")[0]
		args = input.split(" ")[1:]
	else
		key = g.command.split(" ")[0]
		args = g.command.split(" ")[1:]
		g.command = ""
	end if

	if g.tools.hasIndex(key) then
		g.tools[key].exec(args)
	else if g.util.hasIndex(key) then
		g.util[key].exec(args)
	else if g.fs.hasIndex(key) then
		g.fs[key].exec(args)
	else
		if not g.func.run_binary(key, args) then
			print(g.error("Command not recognized: [" + key + "]"))
		end if
	end if
end while