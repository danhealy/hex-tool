// Prints usage and flag descriptions for the ls fs command.
// @return {none}
lsHelp = function
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" {path}") + g.l2(" List files and directories in the current directory, or the specified path.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Displays this help text") + g.const.nl

    print(text)
end function

// Lists the contents of a directory on the current context.
// Respects HEX's tracked currentPath, unlike the /bin/ls binary.
// @param {list<string>|null} args - Optional: [path] to list, or null for current directory.
// @return {number} - 1 on success, 0 on failure.
ls = function(args = null)
    // Wraps a permissions string in a color-coded bracket.
    string.formatPermissions = function
        if not self isa string then
            print(g.error("Invalid type: " + typeof(self)))
            return null
        end if

        if self == "d---------" or self == "----------" then
            return g.l2("[" + self + "]")
        else
            return g.s2("[" + self + "]")
        end if
    end function

    // Wraps a username string in a color-coded bracket.
    string.formatUsername = function
        if not self isa string then
            return self
        end if

        if self == "root" then return g.l2("[" + self + "]") else return g.s2("[" + self + "]")
    end function

    // Returns a color-formatted version of a file's name based on its type and sensitivity.
    map.getFileColor = function
        if typeof(self) != "file" then
            print(g.error("Invalid type: " + typeof(self)))
            return null
        end if

        names = ["Mail.txt","Bank.txt","Map.conf","sources.txt"]
        file = self

        if file.is_folder then return g.s2(file.name)

        if file.is_binary and not file.is_folder then
            if file.name[-3:] == ".so" then
                return g.l3(file.name)
            else
                return g.l2(file.name)
            end if
        end if

        if not file.is_binary then
            if file.name == "passwd" and file.path != "/bin/passwd" then
                if file.has_permission("r") then
                    return g.g1(file.name)
                else
                    return g.o1(file.name)
                end if
            else if names.indexOf(file.name) != null then
                if file.has_permission("r") then
                    return g.g1(file.name)
                else
                    return g.o1(file.name)
                end if
            else
                return g.b1(file.name)
            end if
        end if
    end function

    if args != null and args.len > 0 and (args[0] == "-h" or args[0] == "help") then
        self.help
        return 1
    end if

    if args != null and args.len > 1 then
        self.help
        return 0
    end if

    context = g.stack[g.context.index]
    path = context.currentPath

    if args != null and args.len == 1 then
        argPath = args[0]

        if argPath == "." then
            path = context.currentPath
        else if argPath == ".." then
            if context.currentPath == "/" then
                path = "/"
            else
                parts = context.currentPath.split("/")
                parts.pop
                path = parts.join("/")
                if path == "" then path = "/"
            end if
        else if argPath[0] != "/" then
            path = context.currentPath + "/" + argPath
        else
            path = argPath
        end if

        path = path.replace("//", "/")
    end if

    folder = context.computer.File(path)

    if not folder then
        print g.error("No such file or directory: " + path)
        return 0
    end if

    if not folder.is_folder then
        print g.const.indent + folder.permissions.formatPermissions + " " + folder.owner.formatUsername + g.const.tab + folder.group.formatUsername + g.const.tab + folder.getFileColor
        return 1
    end if

    entries = folder.get_folders + folder.get_files

    if entries.len == 0 then
        print g.s2("total 0")
        return 1
    end if

    // Sort folders first, then files, both alphabetically.
    sorted = []
    folderMap = {}
    fileMap = {}

    for entry in entries
        if entry.is_folder then
            folderMap[entry.name] = entry
        else
            fileMap[entry.name] = entry
        end if
    end for

    folderNames = folderMap.indexes
    fileNames = fileMap.indexes
    folderNames.sort
    fileNames.sort

    for name in folderNames
        sorted.push(folderMap[name])
    end for

    for name in fileNames
        sorted.push(fileMap[name])
    end for

    print g.s2("total " + sorted.len)

    for entry in sorted
        print g.const.indent + entry.permissions.formatPermissions + " " + entry.owner.formatUsername + g.const.tab + entry.group.formatUsername + g.const.tab + entry.getFileColor
    end for

    return 1
end function

g.fs.ls = {
    "name": "ls",
    "shortDescription": "List files and directories in the current directory.",
    "exec": @ls,
    "help": @lsHelp,
}
