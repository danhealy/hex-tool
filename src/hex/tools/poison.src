// Prints usage and flag descriptions for the poison tool.
// @return {none}
poisonHelp = function()
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.l2(" Uploads the best-offensive version of every archived library to the target computer in /lib.  Populate the archive with 'shinylibs scan [path]' and 'shinylibs get'.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Displays this help text") + g.const.nl

    print(text)
end function

// Uploads the best-offensive version of every library in the shinylibs archive to /lib on
// the current target context.
// @param {list<string>|null} args - Pass ["-h"] or ["help"] to show help, or null to run.
// @return {number} - 1 on success, 0 on failure.
doPoison = function(args)
    if args == null or args == [] then
        if not g.func.checkShell(g.context.index) then
            print g.error("No shell available in current context.")
            return 0
        end if

        context = g.stack[g.context.index]

        dest = context.computer.File("/lib")

        if not dest or not dest.has_permission("w") then
            print g.error("No write permission in /lib on target computer.")
            return 0
        end if

        archive = g.func.loadShinylibsDb

        if archive.records.len == 0 then
            print g.error("No archived libraries found. Run 'shinylibs scan [path]' and 'shinylibs get' first.")
            return 0
        end if

        // Collect unique library names
        libNames = {}
        for key in archive.records.indexes
            rec = archive.records[key]
            if not libNames.hasIndex(rec.libName) then libNames[rec.libName] = 1
        end for

        uploaded = 0
        for libName in libNames.indexes
            rec = g.func.getBestOffensiveLib(libName)
            if not rec then continue

            if not g.func.put(rec.path, "/lib") then
                print g.error("Could not upload " + libName + " v" + rec.version + ".")
                continue
            end if

            uploaded = uploaded + 1
            print g.const.indent + g.g1("Uploaded " + libName + " v" + rec.version + " (score=" + rec.topScore + ")")
        end for

        print g.const.nl + g.const.indent + g.s2("Uploaded " + uploaded + " libraries.")

        return 1
    else if args[0] == "help" or args[0] == "-h" then
        g.tools.poison.help()
        return 1
    else
        print g.error("Invalid arguments. Use 'poison help' for usage information.")
        return 0
    end if
end function

g.tools.poison = {
    "name": "poison",
    "shortDescription": "Uploads best-offensive archived libraries to the target computer.",
    "exec": @doPoison,
    "help": @poisonHelp,
    "data": {}
}
