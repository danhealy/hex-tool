// Prints usage and flag descriptions for the scan tool.
// @return {none}
scanHelp = function()
    text = g.const.ni + g.l3("Usage:","u") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [ip] {port}") + g.l2(" Scans for vulnerabilities at the specified ip address and port. If the port is omitted it will scan all open ports instead.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [library.so]") + g.l2(" Scans for vulnerabilities in the specified local library.  Use the full file name for the library, including the '.so' extension.") + g.const.ni
    text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Display this help text") + g.const.nl

    print(text)
end function

// **Scan:**
// Discovers and records exploitable memory addresses and values in metaxploit libraries.
// Accepts an IP with optional port for remote scanning, or a library name for local scanning.
// Results are cached in g.database and displayed unless the silent flag is set.
// @param {list<string>} args - [ip] or [ip, port] for remote; [library.so] for local.
// @return {number} - 1 on success, 0 on failure.
doScan = function(args)
    // Scanning is always performed from the home machine so metaxploit.so is
    // available and DB persistence stays consistent.
    idx = "0"
    context = g.stack[idx]
    if not g.tools.scan.data.hasIndex("silent") then g.tools.scan.data.silent = 0

    // Formats and prints the scan results from the given meta libraries, grouped by lib and version.
    // @param {list<metaLib>} metaLibs - The scanned library objects.
    // @return {number} - Always 1.
    doOutput = function(metaLibs)
        results = {}

        for metaLib in metaLibs
            if not results.hasIndex(metaLib.lib_name) then
                results[metaLib.lib_name] = {}
            end if

            if not results[metaLib.lib_name].hasIndex(metaLib.version) then
                results[metaLib.lib_name][metaLib.version] = {}
            end if
        end for

        libs = results.indexes
        libs.sort

        output = g.const.nl + g.func.heading("Scan Results") + g.const.nl
        for lib in libs
            output = output + g.const.indent + g.s2("Library: " + lib) + g.const.nl

            versions = results[lib].indexes
            versions.sort

            for version in versions
                output = output + g.const.indent + "  " + g.s3("Version: " + version) + g.const.nl

                mems = g.database[lib][version].indexes
                mems.sort

                for mem in mems
                    output = output + g.const.indent + "    " + g.s4("Address: " + mem) + g.const.nl

                    values = g.database[lib][version][mem].indexes
                    values.sort

                    for value in values
                        record = g.func.getExploitRecord(lib, version, mem, value)

                        resultText = "untested"
                        if record.tested == 1 and record.resultType != null then
                            resultText = record.resultType
                            if record.resultUser != null then
                                resultText = resultText + " (" + record.resultUser + ")"
                            end if
                        end if

                        output = output + g.const.indent + "      <size=80%>" + g.o1("Value: " + value + "<pos=550>Result: " + resultText) + g.const.nl
                    end for
                end for
            end for
        end for
        clear_screen
        print output
        return 1
    end function

    // Scans each library in metaLibs for memory addresses and vulnerable values, populating
    // g.database with the results.  Skips libraries whose memory addresses and values are already known.
    // @param {list<metaLib>} metaLibs - The meta library objects to scan.
    // @return {number} - Always 1.
    scanMetaLibs = function(metaLibs)
        dirty = 0
        for metaLib in metaLibs
            if not g.database.hasIndex(metaLib.lib_name) then
                g.database[metaLib.lib_name] = {}
            end if

            if not g.database[metaLib.lib_name].hasIndex(metaLib.version) then
                g.database[metaLib.lib_name][metaLib.version] = {}
            end if

            rescan = 0

            // Check to see if we need to rescan this lib/version.
            mems = g.database[metaLib.lib_name][metaLib.version].indexes

            if not mems or mems.len == 0 then rescan = 1

            if not rescan then
                for mem in mems
                    values = g.database[metaLib.lib_name][metaLib.version][mem].indexes

                    if not values or values.len == 0 then
                        rescan = 1
                        break
                    end if
                end for
            end if

            if rescan then
                dirty = 1
                print g.const.indent + g.s3("Scanning " + metaLib.lib_name + " at version " + metaLib.version + "...")
                mems = g.stack["0"].metax.scan(metaLib)

                for mem in mems
                    g.database[metaLib.lib_name][metaLib.version][mem] = {}

                    vulns = g.stack["0"].metax.scan_address(metaLib, mem).split("Unsafe check: ")[1:]
                    for vuln in vulns
                        value = vuln[vuln.indexOf("<b>")+3:vuln.indexOf("</b>")]

                        record = g.func.getExploitRecord(metaLib.lib_name, metaLib.version, mem, value)
                        record.extraArg = g.func.classifyExtraArg(vuln)
                        parsedReqs = g.func.parseScanAddress(vuln)
                        g.func.mergeRequirements(record.requirements, parsedReqs)
                        if parsedReqs.unknown != null and parsedReqs.unknown isa list then
                            for unk in parsedReqs.unknown
                                g.func.addUnhandledRequirement(unk)
                            end for
                        end if
                        g.func.setExploitRecord(metaLib.lib_name, metaLib.version, mem, value, record)
                    end for
                end for
            end if
        end for

        if dirty then g.func.saveExploitDb
        g.func.reportUnhandledRequirements
        return 1
    end function

    // Scans a local library by loading it from /lib on the home machine and running scanMetaLibs.
    // @param {string} libName - Full path to the library (e.g. "/lib/metaxploit.so").
    // @return {number} - 1 on success, 0 on failure.
    scanLocal = function(libName)
        if not g.func.checkShell(idx) then return 0
        if not g.func.checkMetax(idx) then return 0

        metaLib = context.metax.load(libName)

        if not metaLib then
            print(g.error("Could not load library: " + libName))
            return 0
        end if

        metaLibs = [metaLib]
        scanMetaLibs(metaLibs)

        if not g.tools.scan.data.silent then
            return doOutput(metaLibs)
        end if

        return 1
    end function

    // Connects to a single remote port via metaxploit and scans the dumped library.
    // @param {string} ip - Target IP address.
    // @param {number} port - Target port number.
    // @return {number} - 1 on success, 0 on failure.
    scanRemote = function(ip, port)
        if not g.func.checkShell(idx) then return 0
        if not g.func.checkMetax(idx) then return 0

        netSession = context.metax.net_use(ip, port)

        if typeof(netSession) == "string" then
            print g.error(netSession)
            return 0
        else if netSession == null then
            print g.error("Could not connect to " + ip + ":" + port)
            return 0
        end if

        metaLib = netSession.dump_lib

        metaLibs = [metaLib]

        scanMetaLibs(metaLibs)
        if not g.tools.scan.data.silent then
            return doOutput(metaLibs)
        end if

        return 1
    end function

    // Scans all open ports on the target IP by connecting to each via metaxploit, dumping
    // and scanning each library.  Also scans port 0 (kernel_router) if a router is detected.
    // @param {string} ip - Target IP address (public or LAN).
    // @return {number} - 1 on success, 0 on failure.
    scanAllPorts = function(ip)
        if not g.func.checkShell(idx) then return 0
        if not g.func.checkMetax(idx) then return 0

        router = g.func.getRouter(ip, idx)

        if not is_lan_ip(ip) then
            ports = router.device_ports(router.local_ip)
            isRouter = 1
        else
            ports = router.device_ports(ip)
            isRouter = 0
        end if

        metaLibs = []

        for port in ports
            if is_lan_ip(ip) and port.get_lan_ip != ip then continue
            if port.port_number == 8080 then isRouter = 1
            if port.is_closed and not is_lan_ip(ip) then continue

            netSession = context.metax.net_use(ip, port.port_number)

            if not netSession then
                print(g.error("Could not connect to " + ip + ":" + port.port_number))
            else if typeof(netSession) == "string" then
                print(g.error(netSession))
            else
                metaLib = netSession.dump_lib

                metaLibs.push(metaLib)
            end if
        end for

        if isRouter then
            netSession = context.metax.net_use(ip, 0)

            if not netSession then
                print(g.error("Could not connect to " + ip + ":0"))
            else if typeof(netSession) == "string" then
                print(g.error(netSession))
            else
                metaLib = netSession.dump_lib

                metaLibs.push(metaLib)
            end if
        end if

        scanMetaLibs(metaLibs)
        
        if not g.tools.scan.data.silent then
            return doOutput(metaLibs)
        end if

        return 1
    end function

    if not args or args == [] then
        self.help

        return 0
    else if args.len == 1 then
        arg = args[0]

        if arg == "-h" or arg == "help" then
            self.help

            return 1
        else if not is_valid_ip(arg) then
            if not arg.is_match(".+\.so") then
                print g.error("Invalid library name. (Usage: scan [library.so])")
                return 0
            end if

            return scanLocal("/lib/" + arg)
        else if is_valid_ip(arg) then
            return scanAllPorts(arg)
        else
            print(g.error("Invalid argument: " + arg))
            
            return 0
        end if
    else if args.len == 2 then
        address = args[0]
        port = args[1]

        if not is_valid_ip(address) then
            print(g.const.indent + g.error("Invalid IP address: " + address))
            return 0
        end if

        if port.val == null or port.to_int < 0 or port.to_int > 65535 then
            print(g.const.indent + g.error("Invalid port number: " + port))
            return 0
        end if

        return scanRemote(address, port.to_int)
    end if
end function

g.tools.scan = {
    "name": "scan",
    "shortDescription": "Scans for vulnerabilities.",
    "exec": @doScan,
    "help": @scanHelp,
    "data": {}
}