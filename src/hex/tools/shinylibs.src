// Prints usage text for the shinylibs tool.
// @return {none}
shinylibsHelp = function
	text = g.const.ni + g.l3("Usage:", "u") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" scan") + g.l2(" {path} {force}") + g.l2(" Scans the target directory for .so libraries and stages every one found (default: /lib). Use 'force' to rescan already-archived or staged libraries.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" info") + g.l2(" {libname.so} {version}") + g.l2(" With no arguments, lists all known library versions, best exploits, and unhandled requirements. With a library name, lists every known exploit for that library/version.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" info clear-unhandled") + g.l2(" Clears the persistent unhandled requirement pattern list.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" req-patterns") + g.l2(" Dumps every unique requirement bullet pattern seen, marked handled or unhandled.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" get") + g.l2(" Copies all staged libraries to the local archive under /root/hex-shinylibs/. If nothing is staged, /lib is auto-scanned and any unscanned .so files are copied.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" put vuln") + g.l2(" Replaces target /lib libraries with the most vulnerable archived versions.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" put harden") + g.l2(" Replaces target /lib libraries with the most hardened archived versions.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" harden") + g.l2(" Interactively harden /lib libraries by choosing from the most defensive archived versions.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" harden defaults") + g.l2(" Automatically replace /lib libraries with the most defensive archived versions without prompting.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" test") + g.l2(" {libname.so} {version}") + g.l2(" Attempts every known exploit for the archived library version on the home computer and records the granted handle. If version is omitted, every archived version is tested. Already-tested exploits are skipped.") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" migrate") + g.l2(" Migrates legacy exploit database keys (e.g. missingLib -> requiredLib).") + g.const.ni
	text = text + g.g2(self.name) + g.b3(" [-h/help]") + g.l2(" Display this help text.") + g.const.nl
	print text
end function

// Scores a single scan_address result line.
// Returns a numeric score based on the result type and constraint penalties.
// @param {string} result - A single result string from metax.scan_address (the part after "Unsafe check: ").
// @return {number} - The calculated score (floored at 0).
scoreScanResult = function(result)
	lower = result.lower

	// Base score by result type
	score = 0
	if lower.indexOf("root shell") != null then
		score = 100
	else if lower.indexOf("shell") != null then
		score = 60
	else if lower.indexOf("computer") != null then
		score = 20
	else if lower.indexOf("file") != null then
		score = 10
	else if lower.indexOf("firewall") != null or lower.indexOf("number") != null then
		score = 5
	end if

	// Constraint penalties
	if lower.indexOf("any user") != null then
		score -= 20
	else if lower.indexOf("admin") != null or lower.indexOf("active user") != null then
		score -= 40
	end if

	if lower.indexOf("registered users") != null or lower.indexOf("user count") != null then
		score -= 10
	end if

	if lower.indexOf("port forward") != null then
		score -= 10
	end if

	if lower.indexOf("firewall off") != null then
		score -= 15
	end if

	if score < 0 then score = 0
	return score
end function

// Scores all exploits in a metaxploit library and returns a summary map.
// Also seeds each combo's extraArg and requirements from the scan_address text.
// @param {metaLib} metaLib - The loaded meta library to score.
// @param {metaxploitLib} metax - The metaxploit library object.
// @return {map} - {topScore, allScores:[{mem, value, score}]}
scoreLib = function(metaLib, metax)
	summary = {
		"topScore": 0,
		"allScores": [],
	}
	mems = metax.scan(metaLib)
	if not mems or mems == [] then return summary

	for mem in mems
		raw = metax.scan_address(metaLib, mem)
		if raw == null then continue
		results = raw.split("Unsafe check: ")[1 : ]
		for res in results
			value = res[res.indexOf("<b>") + 3 : res.indexOf("</b>")]
			record = g.func.getExploitRecord(
				metaLib.lib_name,
				metaLib.version,
				mem,
				value)
			record.extraArg = g.func.classifyExtraArg(res)
			parsedReqs = g.func.parseScanAddress(res)
			g.func.mergeRequirements record.requirements, parsedReqs
			if parsedReqs.unknown != null and parsedReqs.unknown isa list then
				for unk in parsedReqs.unknown
					g.func.addUnhandledRequirement unk
				end for
			end if
			g.func.setExploitRecord(
				metaLib.lib_name,
				metaLib.version,
				mem,
				value,
				record)
			sc = null
			if record.tested == 1 then sc = g.func.scoreExploitRecord(record)
			if sc == null then sc = scoreScanResult(res)
			entry = {
				"mem": mem,
				"value": value,
				"score": sc,
			}
			summary.allScores.push entry
			if sc > summary.topScore then summary.topScore = sc
		end for
	end for

	g.func.reportUnhandledRequirements

	return summary
end function

// Reconstructs a score summary from g.database cache without issuing any metaxploit calls.
// Returns null if the cache is incomplete or if any combo has not been seeded with
// extraArg/requirements by the new parser.
// @param {string} libName - The library name (e.g. "libssh.so").
// @param {string} ver - The library version string.
// @return {map|null} - {topScore, allScores:[{mem, value, score}]} or null if cache incomplete.
scoreLibFromCache = function(libName, ver)
	if not g.database.hasIndex(libName) then return null
	if not g.database[libName].hasIndex(ver) then return null

	mems = g.database[libName][ver].indexes
	if not mems or mems.len == 0 then return null

	summary = {
		"topScore": 0,
		"allScores": [],
	}

	for mem in mems
		values = g.database[libName][ver][mem].indexes
		if not values or values.len == 0 then return null

		for value in values
			res = g.database[libName][ver][mem][value]
			sc = null
			if typeof(res) == "map" and res.hasIndex("tested") and res.tested == 1 then
				sc = g.func.scoreExploitRecord(res)
			else if typeof(res) == "string" and res != "" then
				sc = scoreScanResult(res)
			else if typeof(res) == "map" and res.hasIndex("extraArg") and res.extraArg != null then
				// Seeded but untested; no scan text available, so score 0.
				sc = 0
			else
				return null
			end if
			entry = {
				"mem": mem,
				"value": value,
				"score": sc,
			}
			summary.allScores.push entry
			if sc > summary.topScore then summary.topScore = sc
		end for
	end for

	return summary
end function

// Aggregates requirements for a lib/version from the exploit DB.
// @param {string} libName - Library name.
// @param {string} ver - Library version.
// @return {map} - A merged requirements map.
getArchiveRequirements = function(libName, ver)
	reqs = g.func.newExploitRequirements
	if not g.database.hasIndex(libName) then return reqs
	if not g.database[libName].hasIndex(ver) then return reqs

	mems = g.database[libName][ver].indexes
	for mem in mems
		values = g.database[libName][ver][mem].indexes
		for value in values
			record = g.func.getExploitRecord(
				libName,
				ver,
				mem,
				value)
			g.func.mergeRequirements reqs, record.requirements
		end for
	end for

	return reqs
end function

// **shinylibs scan:**
// Scans all .so files in the given directory (default /lib) on the current shell context.
// Stages every library found. Use `force` to rescan lib/version pairs that are already
// archived or staged.
// @param {string} scanPath - Directory to scan (default "/lib").
// @param {number} force - If 1, rescan even if already archived or staged.
// @return {none}
shinylibsScan = function(scanPath = "/lib", force = 0)
	idx = g.context.index
	if not g.func.checkShell(idx) then return 
	if not g.func.checkMetax(idx) then
		if not g.func.attach_metax(idx) then return 
	end if

	context = g.stack[idx]
	metax = context.metax

	libsDir = context.computer.File(scanPath)
	if not libsDir then
		print g.error("shinylibs scan: " + scanPath + " not found on current context.")
		return 
	end if

	if not libsDir.is_folder then
		print g.error("shinylibs scan: " + scanPath + " is not a directory.")
		return 
	end if

	archive = g.func.loadShinylibsDb

	staged = 0
	total = 0

	for f in libsDir.get_files
		if f.name[-3 : ] != ".so" then continue
		total += 1

		metaLib = metax.load(f.path)
		if not metaLib then continue

		libName = metaLib.lib_name
		ver = metaLib.version
		archiveKey = libName + "/" + ver

		if not force then
			// Skip lib/version pairs already collected or already staged
			if archive.records.hasIndex(archiveKey) then
				print g.const.indent + g.d1("  " + libName + " v" + ver + " — already in archive, skipping.")
				continue
			end if

			alreadyStaged = 0
			for entry in archive.staged
				if entry.libName == libName and entry.version == ver then
					alreadyStaged = 1
					break
				end if
			end for
			if alreadyStaged then
				print g.const.indent + g.d1("  " + libName + " v" + ver + " — already staged, skipping.")
				continue
			end if
		else
			// Remove any existing archive record so the rescan replaces it on the next get.
			if archive.records.hasIndex(archiveKey) then
				archive.records.remove archiveKey
				print g.const.indent + g.y1("  " + libName + " v" + ver + " — removed existing archive record for rescan.")
			end if

			// Remove any existing staged entry to avoid duplicates.
			i = archive.staged.len - 1
			while i >= 0
				entry = archive.staged[i]
				if entry.libName == libName and entry.version == ver then
					archive.staged.remove i
				end if
				i -= 1
			end while
		end if

		// When forcing, always rescan; otherwise try cache first.
		if force == 1 then
			print g.const.indent + g.s3("Rescanning " + libName + " v" + ver + " (force)...")
			summary = scoreLib(metaLib, metax)
		else
			summary = scoreLibFromCache(libName, ver)
			if summary != null then
				print g.const.indent + g.s3("Scoring " + libName + " v" + ver + " (from cache)...")
			else
				print g.const.indent + g.s3("Scoring " + libName + " v" + ver + "...")
				summary = scoreLib(metaLib, metax)
			end if
		end if
		topScore = summary.topScore

		// Determine whether this is the best offensive or most defensive candidate
		bestOffScore = -1
		bestDefScore = 999999

		for key in archive.records.indexes
			parts = key.split("/")
			if parts.len < 2 then continue
			rLibName = parts[0]
			if rLibName != libName then continue
			rec = archive.records[key]
			if rec.topScore > bestOffScore then bestOffScore = rec.topScore
			if rec.topScore < bestDefScore then bestDefScore = rec.topScore
		end for

		// Also check staged entries
		for entry in archive.staged
			if entry.libName != libName then continue
			if entry.topScore > bestOffScore then bestOffScore = entry.topScore
			if entry.topScore < bestDefScore then bestDefScore = entry.topScore
		end for

		isOffensive = topScore > bestOffScore
		isDefensive = topScore == 0 and bestDefScore > 0

		stageEntry = {
			"libName": libName,
			"version": ver,
			"path": f.path,
			"topScore": topScore,
			"allScores": summary.allScores,
			"isOffensive": isOffensive,
			"isDefensive": isDefensive,
			"conditions": null,
		}
		archive.staged.push stageEntry
		staged += 1
		tag = ""
		if isOffensive then tag = tag + g.r1("[offensive]") + " "
		if isDefensive then tag = tag + g.g1("[defensive]") + " "
		print g.const.indent + g.g2("  Staged " + libName + " v" + ver + " (score=" + topScore + ") " + tag)
	end for

	g.func.saveShinylibsDb archive

	print g.const.indent + g.s2("Scanned " + total + " libraries, staged " + staged + " entries.")
	if staged > 0 then
		print g.const.indent + g.l2("Auto-running 'shinylibs get'...")
		shinylibsGet
	end if
end function

// **shinylibs req-patterns:**
// Dumps every unique requirement bullet pattern seen by the scanner and whether
// the parser currently recognizes it.
// @return {none}
shinylibsReqPatterns = function
	if not g.hasIndex("requirementPatterns") then g.requirementPatterns = []
	if not (g.requirementPatterns isa list) then g.requirementPatterns = []

	print g.const.nl + g.func.heading("Requirement Patterns")

	if g.requirementPatterns.len == 0 then
		print g.const.indent + g.d1("No requirement patterns recorded. Run 'shinylibs scan' first.")
		print ""
		return 
	end if

	handledCount = 0
	unhandledCount = 0
	for entry in g.requirementPatterns
		if entry.hasIndex("handled") and entry.handled == 1 then
			handledCount += 1
		else
			unhandledCount += 1
		end if
	end for

	print g.const.indent + g.s2("Total: " + g.requirementPatterns.len + "  " + g.g1("handled: " + handledCount) + "  " + g.r1("unhandled: " + unhandledCount))

	// List unhandled patterns first.
	for entry in g.requirementPatterns
		if entry.hasIndex("handled") and entry.handled == 1 then continue
		line = entry.hasIndex("line") and entry.line or ""
		print g.const.indent + g.r1("[unhandled]") + " " + g.l2(line)
	end for

	for entry in g.requirementPatterns
		if not (entry.hasIndex("handled") and entry.handled == 1) then continue
		line = entry.hasIndex("line") and entry.line or ""
		print g.const.indent + g.g1("[handled]") + "   " + g.l2(line)
	end for

	print ""
end function

// Orders a list of users for display: root first, then guest, then others.
// @param {list<string>} users - Users to order.
// @return {list<string>} - Ordered users.
shinylibsOrderUsers = function(users)
	ordered = []
	for u in users
		if u == "root" then ordered.push(u)
	end for
	for u in users
		if u == "guest" then ordered.push(u)
	end for
	for u in users
		if u != "root" and u != "guest" then ordered.push(u)
	end for
	return ordered
end function

// **shinylibs info (all):**
// Displays all known library versions from the exploit DB and archive, marking any
// version whose binary is missing from the home shinylibs directory in bold.
// Also shows the most useful exploits per handle type and any unhandled patterns.
// @return {none}
shinylibsInfoAll = function
	archive = g.func.loadShinylibsDb
	home = g.stack["0"]

	print g.const.nl + g.func.heading("ShinyLibs Archive")

	// Index archived records by libName -> version -> record.
	archivedVersions = {}
	for key in archive.records.indexes
		parts = key.split("/")
		if parts.len < 2 then continue
		libName = parts[0]
		ver = parts[1]
		if not archivedVersions.hasIndex(libName) then archivedVersions[libName] = {}
		archivedVersions[libName][ver] = archive.records[key]
	end for

	// Index staged entries by libName -> version -> entry.
	stagedVersions = {}
	for entry in archive.staged
		if not stagedVersions.hasIndex(entry.libName) then stagedVersions[entry.libName] = {}
		stagedVersions[entry.libName][entry.version] = entry
	end for

	// Gather every library known to the database or the archive.
	allLibs = {}
	for libName in g.database.indexes
		if libName.len >= 2 and libName[ : 2] == "__" then continue
		if not (g.database[libName] isa map) then continue
		allLibs[libName] = 1
	end for
	for libName in archivedVersions.indexes
		allLibs[libName] = 1
	end for

	if allLibs.len == 0 and archive.staged.len == 0 then
		print g.const.indent + g.d1("Archive is empty.  Run 'shinylibs scan [path]' on a target.")
		return 
	end if

	libNames = allLibs.indexes
	libNames.sort

	for libName in libNames
		isRemote = g.const.SHINYLIBS_REMOTE_LIBS.indexOf(libName) != null
		remoteTag = ""
		if isRemote then remoteTag = g.y1(" [remote-access]")
		print g.const.indent + g.s2(libName) + remoteTag

		// Collect every known version for this library.
		versions = {}
		if g.database.hasIndex(libName) and g.database[libName] isa map then
			for ver in g.database[libName].indexes
				versions[ver] = 1
			end for
		end if
		if archivedVersions.hasIndex(libName) then
			for ver in archivedVersions[libName].indexes
				versions[ver] = 1
			end for
		end if
		versionList = versions.indexes
		versionList.sort

		bestOffRec = null
		bestDefRec = null

		for ver in versionList
			expectedPath = g.const.SHINYLIBS_BIN_PATH + "/" + libName + "/" + ver + "/" + libName
			hasBinary = home.computer.File(expectedPath) != null

			rec = null
			if archivedVersions.hasIndex(libName) and archivedVersions[libName].hasIndex(ver) then
				rec = archivedVersions[libName][ver]
			end if

			if rec != null then
				if bestOffRec == null or rec.topScore > bestOffRec.topScore then bestOffRec = rec
				if bestDefRec == null or rec.topScore < bestDefRec.topScore then bestDefRec = rec
			end if

			versionLabel = "v" + ver
			if not hasBinary then versionLabel = g.func.format(versionLabel, [ "b" ])

			tags = []
			if rec != null then tags.push("archived")
			if stagedVersions.hasIndex(libName) and stagedVersions[libName].hasIndex(ver) then tags.push("staged")

			topScore = "?"
			if rec != null then
				topScore = rec.topScore
			else
				cached = scoreLibFromCache(libName, ver)
				if cached != null then topScore = cached.topScore
			end if

			line = g.const.indent + "  " + versionLabel
			if tags.len > 0 then line = line + " (" + tags.join(", ") + ")"
			line = line + g.const.tab + "score=" + topScore
			print line
		end for

		if bestOffRec != null then
			print g.const.indent + "  " + g.r1("Best offensive:") + " v" + bestOffRec.version + g.const.tab + "score=" + bestOffRec.topScore
			if bestOffRec.hasIndex("requirements") and bestOffRec.requirements != null then
				reqText = g.func.formatRequirements(bestOffRec.requirements)
				if reqText != "" then print g.const.indent + "      " + g.d1("[" + reqText + "]")
			end if
		end if

		if bestDefRec != null and bestDefRec.topScore == 0 then
			print g.const.indent + "  " + g.g1("Most defensive:") + " v" + bestDefRec.version + g.const.tab + "score=0"
			if bestDefRec.hasIndex("requirements") and bestDefRec.requirements != null then
				reqText = g.func.formatRequirements(bestDefRec.requirements)
				if reqText != "" then print g.const.indent + "      " + g.d1("[" + reqText + "]")
			end if
		end if
	end for

	if archive.staged.len > 0 then
		print g.const.nl + g.const.indent + g.s3("Staged (awaiting 'shinylibs get'):")
		for entry in archive.staged
			isRemote = g.const.SHINYLIBS_REMOTE_LIBS.indexOf(entry.libName) != null
			remoteTag = ""
			if isRemote then remoteTag = g.y1(" [remote-access]")
			tag = ""
			if entry.isOffensive then tag = tag + g.r1("[off]") + " "
			if entry.isDefensive then tag = tag + g.g1("[def]") + " "
			print g.const.indent + "  " + g.l2(entry.libName + " v" + entry.version) + " score=" + entry.topScore + " " + tag + remoteTag
		end for
	end if

	// Most useful exploits: best unrestricted/easiest restricted per handle type.
	byType = g.func.getBestExploitsByType
	if byType.len > 0 then
		print g.const.nl + g.func.heading("Most Useful Exploits")

		typeOrder = [
			"shell",
			"computer",
			"file",
			"passwordReset",
			"firewall",
			"settings",
			"trafficLight",
			"number",
		]
		typeLabels = {
			"shell": "Shell",
			"computer": "Computer",
			"file": "File",
			"passwordReset": "Password Reset",
			"firewall": "Firewall",
			"settings": "Settings",
			"trafficLight": "Traffic Light",
			"number": "Number",
		}

		for typeKey in typeOrder
			if not byType.hasIndex(typeKey) then continue
			bucket = byType[typeKey]

			label = typeKey
			if typeLabels.hasIndex(typeKey) then label = typeLabels[typeKey]
			print g.const.indent + g.s2(label)

			if bucket.unrestricted.len > 0 then
				users = shinylibsOrderUsers(bucket.unrestricted.indexes)
				for user in users
					entry = bucket.unrestricted[user]
					line = g.const.indent + "  " + g.g1(entry.user) + " — " + entry.libName + " v" + entry.version + " @ " + entry.mem + "=" + entry.value + "  score=" + entry.score
					print line
				end for
			else if bucket.restricted.len > 0 then
				print g.const.indent + "  " + g.y1("No unrestricted exploits; easiest restrictions:")
				users = shinylibsOrderUsers(bucket.restricted.indexes)
				for user in users
					entry = bucket.restricted[user]
					line = g.const.indent + "    " + g.y1(entry.user) + " — " + entry.libName + " v" + entry.version + " @ " + entry.mem + "=" + entry.value + "  score=" + entry.score
					if entry.reqText != "" then line = line + "  [" + entry.reqText + "]"
					print line
				end for
			else
				print g.const.indent + "  " + g.d1("No tested exploits recorded.")
			end if
		end for
	end if

	if g.hasIndex("unhandledRequirements") and g.unhandledRequirements isa list and g.unhandledRequirements.len > 0 then
		print g.const.nl + g.func.heading("Unhandled Requirement Patterns")
		for line in g.unhandledRequirements
			print g.const.indent + g.d1(line)
		end for
	end if

	print ""
end function

// **shinylibs auto-stage:**
// Scans /lib on the current context and stages every .so that is not already archived
// or staged. Used as a fallback when 'shinylibs get' is run without a prior scan.
// Libraries are staged without exploit scores so they can still be copied to the home
// archive.
// @return {number} - 1 if staging completed, 0 on error.
shinylibsAutoStage = function
	idx = g.context.index
	if not g.func.checkShell(idx) then return 0
	if not g.func.checkMetax(idx) then
		if not g.func.attach_metax(idx) then return 0
	end if

	context = g.stack[idx]
	metax = context.metax

	libsDir = context.computer.File("/lib")
	if not libsDir then
		print g.error("shinylibs get: /lib not found on current context.")
		return 0
	end if

	archive = g.func.loadShinylibsDb
	staged = 0

	for f in libsDir.get_files
		if f.name[-3 : ] != ".so" then continue

		metaLib = metax.load(f.path)
		if not metaLib then continue

		libName = metaLib.lib_name
		ver = metaLib.version
		archiveKey = libName + "/" + ver

		if archive.records.hasIndex(archiveKey) then continue

		alreadyStaged = 0
		for entry in archive.staged
			if entry.libName == libName and entry.version == ver then
				alreadyStaged = 1
				break
			end if
		end for
		if alreadyStaged then continue

		stageEntry = {
			"libName": libName,
			"version": ver,
			"path": f.path,
			"topScore": 0,
			"allScores": [],
			"isOffensive": 0,
			"isDefensive": 0,
			"conditions": null,
		}
		archive.staged.push stageEntry
		staged += 1
		print g.const.indent + g.g2("  Staged " + libName + " v" + ver + " (unscanned)")
	end for

	g.func.saveShinylibsDb archive
	print g.const.indent + g.s2("Auto-staged " + staged + " unscanned librar" + (staged == 1 and "y" or "ies") + " from /lib.")
	return 1
end function

// **shinylibs get:**
// Copies all staged libraries from the current context to the home archive automatically.
// On transfer failure the entry remains staged so it can be retried.
// @return {none}
shinylibsGet = function
	archive = g.func.loadShinylibsDb

	if archive.staged.len == 0 then
		print g.const.indent + g.y1("Nothing is staged. Auto-staging libraries from /lib...")
		if not shinylibsAutoStage then return 
		archive = g.func.loadShinylibsDb
		if archive.staged.len == 0 then
			print g.const.indent + g.d1("No libraries available to copy.")
			return 
		end if
	end if

	idx = g.context.index
	if not g.func.checkShell(idx) then return 
	context = g.stack[idx]
	home = g.stack["0"]

	collected = []
	total = archive.staged.len

	for i in range(0, total - 1)
		entry = archive.staged[i]
		tag = ""
		if entry.isOffensive then tag += " [offensive]"
		if entry.isDefensive then tag += " [defensive]"
		print g.const.indent + g.s3("Collecting " + entry.libName + " v" + entry.version + tag + " (score=" + entry.topScore + ")...")

		destDir = g.const.SHINYLIBS_BIN_PATH + "/" + entry.libName + "/" + entry.version
		if not g.func.ensureShinylibsDir(destDir) then
			print g.error("shinylibs get: could not create directory " + destDir + ". Entry remains staged.")
			continue
		end if

		result = g.func.transfer(
			context.shell,
			entry.path,
			home.shell,
			destDir)
		if not result then
			print g.error("shinylibs get: transfer failed for " + entry.libName + " v" + entry.version + ". Entry remains staged.")
			continue
		end if

		// Move from staged to records
		archiveKey = entry.libName + "/" + entry.version
		archiveRec = {
			"libName": entry.libName,
			"version": entry.version,
			"path": destDir + "/" + entry.libName,
			"topScore": entry.topScore,
			"allScores": entry.allScores,
			"isOffensive": entry.isOffensive,
			"isDefensive": entry.isDefensive,
			"conditions": entry.conditions,
			"requirements": getArchiveRequirements(entry.libName, entry.version),
			"archivedAt": time,
		}
		archive.records[archiveKey] = archiveRec
		collected.push i
		print g.const.indent + g.g1("  -> " + destDir)
	end for

	// Remove collected entries from staged (iterate in reverse to preserve indices)
	i = collected.len - 1
	while i >= 0
		archive.staged.remove collected[i]
		i -= 1
	end while

	g.func.saveShinylibsDb archive

	failed = total - collected.len
	print g.const.indent + g.s3("Collected " + collected.len + " of " + total + " staged entries." + (failed > 0 and " " + failed + " failed — retry with 'shinylibs get'." or ""))
end function

// **shinylibs put:**
// Replaces target /lib libraries with archived versions.
// mode: "vuln" = most offensive, "harden" = most defensive.
// @param {string} mode - "vuln" or "harden"
// @return {none}
shinylibsPut = function(mode)
	if mode != "vuln" and mode != "harden" then
		print g.error("shinylibs put: invalid mode '" + mode + "'. Use 'vuln' or 'harden'.")
		return 
	end if

	idx = g.context.index
	if not g.func.checkShell(idx) then return 
	context = g.stack[idx]
	home = g.stack["0"]

	libsDir = context.computer.File("/lib")
	if not libsDir then
		print g.error("shinylibs put: /lib not found on current context.")
		return 
	end if

	archive = g.func.loadShinylibsDb

	if archive.records.len == 0 then
		print g.const.indent + g.d1("Archive is empty.  Run 'shinylibs scan [path]' and 'shinylibs get' first.")
		return 
	end if

	// Build best-per-libname index from archive
	bestByLib = {}
	for key in archive.records.indexes
		rec = archive.records[key]
		libName = rec.libName
		if not bestByLib.hasIndex(libName) then
			bestByLib[libName] = rec
		else
			existing = bestByLib[libName]
			if mode == "vuln" and rec.topScore > existing.topScore then
				bestByLib[libName] = rec
			else if mode == "harden" and rec.topScore < existing.topScore then
				bestByLib[libName] = rec
			end if
		end if
	end for

	metax = context.metax
	if metax == null then
		print g.error("shinylibs put: metaxploit not attached on current context — cannot verify library versions. Run 'jump' to attach it first.")
		return 
	end if

	replaced = 0

	for f in libsDir.get_files
		if f.name[-3 : ] != ".so" then continue
		libName = f.name

		if not bestByLib.hasIndex(libName) then continue

		best = bestByLib[libName]

		// Check if target already has this version
		metaLib = metax.load(f.path)
		if metaLib != null and metaLib.version == best.version then
			print g.const.indent + g.d1(libName + " already at v" + best.version + ", skipping.")
			continue
		end if

		tag = ""
		if mode == "vuln" then tag = " (offensive, score=" + best.topScore + ")"
		if mode == "harden" then tag = " (defensive, score=" + best.topScore + ")"

		prompt = g.const.indent + g.l2("Replace " + libName + " with v" + best.version + tag + "? [y/N] ")
		ans = user_input(
			prompt,
			0,
			0,
			0)
		if ans.lower != "y" then continue

		srcPath = g.const.SHINYLIBS_BIN_PATH + "/" + libName + "/" + best.version + "/" + libName

		result = g.func.transfer(
			home.shell,
			srcPath,
			context.shell,
			"/lib")
		if not result then
			print g.error("shinylibs put: transfer failed for " + libName)
			continue
		end if

		// Rename to canonical libName if needed (transfer may preserve source filename)
		destFile = context.computer.File("/lib/" + libName)
		if not destFile then
			print g.error("shinylibs put: transferred file not found at /lib/" + libName)
			continue
		end if

		replaced += 1
		print g.const.indent + g.g1("Replaced " + libName + " with v" + best.version)
	end for

	print g.const.nl + g.const.indent + g.s3("Replaced " + replaced + " libraries.")
	if replaced > 0 then
		print g.const.indent + g.y1("Warning: SCP creates logs on the target.  Run 'corruptlogs' or 'log clear' to clean up.")
	end if
end function

// Bubble-sorts a list of maps by a numeric key.
// @param {list} list - The list to sort in-place.
// @param {string} key - The map key to compare.
// @param {number} desc - If 1, highest first; otherwise lowest first.
// @return {list} - The sorted list.
shinylibsSortByKey = function(list, key, desc = 0)
	n = list.len
	while n > 1
		newN = 0
		for i in range(1, n - 1)
			a = list[i - 1][key]
			b = list[i][key]
			if a == null then a = 0
			if b == null then b = 0
			swap = 0
			if desc == 1 and a < b then swap = 1
			if desc == 0 and a > b then swap = 1
			if swap then
				tmp = list[i - 1]
				list[i - 1] = list[i]
				list[i] = tmp
				newN = i
			end if
		end for
		n = newN
	end while
	return list
end function

// Collects every known exploit for a specific lib/version from the exploit DB.
// @param {string} libName - Library name.
// @param {string} ver - Library version.
// @return {list} - Exploit entries sorted by score (highest first).
shinylibsGetKnownExploits = function(libName, ver)
	entries = []
	if not g.database.hasIndex(libName) then return entries
	if not g.database[libName].hasIndex(ver) then return entries
	if not (g.database[libName][ver] isa map) then return entries

	for mem in g.database[libName][ver].indexes
		if not (g.database[libName][ver][mem] isa map) then continue
		values = g.database[libName][ver][mem].indexes
		for value in values
			record = g.func.getExploitRecord(libName, ver, mem, value)
			sc = 0
			typeLabel = "untested"
			userLabel = null
			if record.tested == 1 then
				sc = g.func.scoreExploitRecord(record)
				if record.resultType != null and record.resultType != "null" then
					typeLabel = record.resultType
				end if
				userLabel = record.resultUser
			end if

			entries.push({
				"mem": mem,
				"value": value,
				"type": typeLabel,
				"user": userLabel,
				"score": sc,
				"reqText": g.func.formatRequirements(record.requirements),
			})
		end for
	end for

	return shinylibsSortByKey(entries, "score", 1)
end function

// Prints exploit entries as handle, permission level, and requirements.
// @param {list} entries - Entries returned by shinylibsGetKnownExploits.
// @param {string} indent - Leading whitespace for each line.
// @return {none}
shinylibsPrintExploits = function(entries, indent)
	if entries.len == 0 then
		print indent + g.d1("No known exploits.")
		return
	end if

	for entry in entries
		handle = entry.type
		if handle == "passwordReset" then handle = "password reset"
		if handle == "trafficLight" then handle = "traffic light"

		user = ""
		if entry.user != null then user = " " + entry.user

		reqs = ""
		if entry.reqText != "" then reqs = " [" + entry.reqText + "]"

		colorHandle = g.l2(handle)
		if entry.type == "shell" then colorHandle = g.r1(handle)
		if entry.type == "computer" then colorHandle = g.y1(handle)
		if entry.type == "file" then colorHandle = g.g1(handle)
		if entry.type == "untested" then colorHandle = g.d1(handle)

		print indent + g.l2(entry.mem + "=" + entry.value) + "  " + colorHandle + user + g.l2(reqs)
	end for
end function

// Prints a version block: label, top score, and every known exploit.
// @param {string} libName - Library name.
// @param {string} ver - Library version.
// @param {map} archive - Loaded shinylibs archive.
// @param {string} label - Label prefix (e.g. "Current:" or "[1]").
// @param {string} indent - Base indentation for the version line.
// @param {string} innerIndent - Additional indentation for exploit lines.
// @return {none}
shinylibsPrintVersionInfo = function(libName, ver, archive, label, indent, innerIndent)
	score = shinylibsGetVersionTopScore(libName, ver, archive)
	archiveKey = libName + "/" + ver
	archivedTag = ""
	if archive.records.hasIndex(archiveKey) then
		archivedTag = " " + g.g1("[archived]")
	else
		archivedTag = " " + g.d1("[not archived]")
	end if
	print indent + label + " v" + ver + "  score=" + score + archivedTag
	shinylibsPrintExploits(shinylibsGetKnownExploits(libName, ver), indent + innerIndent)
end function

// Returns the best-known top score for a lib/version.
// Prefers the archive record, then falls back to a cache-only score.
// @param {string} libName - Library name.
// @param {string} ver - Library version.
// @param {map} archive - Loaded shinylibs archive.
// @return {number|string} - Top score, or "?" if unknown.
shinylibsGetVersionTopScore = function(libName, ver, archive)
	key = libName + "/" + ver
	if archive.records.hasIndex(key) then return archive.records[key].topScore

	cached = scoreLibFromCache(libName, ver)
	if cached != null then return cached.topScore

	return "?"
end function

// Returns all archived versions of a library sorted from most to least defensive.
// @param {string} libName - Library name.
// @param {map} archive - Loaded shinylibs archive.
// @return {list} - Archive records sorted by topScore ascending.
shinylibsGetArchivedVersions = function(libName, archive)
	versions = []
	for key in archive.records.indexes
		parts = key.split("/")
		if parts.len < 2 then continue
		if parts[0] != libName then continue
		versions.push(archive.records[key])
	end for
	return shinylibsSortByKey(versions, "topScore", 0)
end function

// **shinylibs harden:**
// Interactively replaces /lib libraries with the most defensive archived versions.
// With useDefaults set to 1, prompts are skipped and the best defensive version is
// applied to every library automatically.
// @param {number} useDefaults - If 1, apply defaults without prompting.
// @return {none}
shinylibsHarden = function(useDefaults = 0)
	idx = g.context.index
	if not g.func.checkShell(idx) then return
	context = g.stack[idx]
	home = g.stack["0"]

	metax = context.metax
	if metax == null then
		print g.error("shinylibs harden: metaxploit not attached on current context — cannot verify library versions. Run 'jump' to attach it first.")
		return
	end if

	libsDir = context.computer.File("/lib")
	if not libsDir then
		print g.error("shinylibs harden: /lib not found on current context.")
		return
	end if

	archive = g.func.loadShinylibsDb
	if archive.records.len == 0 then
		print g.const.indent + g.d1("Archive is empty. Run 'shinylibs scan [path]' and 'shinylibs get' first.")
		return
	end if

	if not useDefaults then
		print g.const.nl + g.func.heading("ShinyLibs Harden")
	end if

	replaced = 0
	skipped = 0

	for f in libsDir.get_files
		if f.name[-3:] != ".so" then continue
		libName = f.name

		archivedVersions = shinylibsGetArchivedVersions(libName, archive)
		if archivedVersions.len == 0 then
			if not useDefaults then
				print g.const.nl + g.const.indent + g.l2(libName) + " " + g.d1("— no archived versions.")
			end if
			continue
		end if

		metaLib = metax.load(f.path)
		currentVer = null
		if metaLib != null then currentVer = metaLib.version

		if not useDefaults then
			print g.const.nl + g.const.indent + g.s2(libName)

			if currentVer == null then
				print g.const.indent + "  " + g.y1("Current: unknown (could not load with metaxploit)")
			else
				shinylibsPrintVersionInfo(libName, currentVer, archive, g.y1("Current:"), g.const.indent + "  ", "  ")
			end if
		end if

		limit = 5
		if archivedVersions.len < limit then limit = archivedVersions.len
		top5 = []
		for i in range(0, limit - 1)
			top5.push(archivedVersions[i])
		end for

		if not useDefaults then
			print g.const.indent + "  " + g.g1("Defensive options:")
			for i in range(0, top5.len - 1)
				rec = top5[i]
				shinylibsPrintVersionInfo(libName, rec.version, archive, "[" + (i + 1) + "]", g.const.indent + "    ", "  ")
			end for

			defaultVer = top5[0].version
			prompt = g.const.indent + "  Replace with [1-" + top5.len + ", version, Enter=" + defaultVer + ", n=keep]? "
			ans = user_input(prompt, 0, 0, 0)
			ans = ans.trim

			target = null
			if ans == "" then
				target = top5[0]
			else if ans.lower == "n" or ans.lower == "no" or ans.lower == "skip" then
				target = null
			else
				num = ans.to_int
				if typeof(num) == "number" and num >= 1 and num <= top5.len then
					target = top5[num - 1]
				else
					for rec in archivedVersions
						if rec.version == ans then
							target = rec
							break
						end if
					end for
					if target == null then
						print g.const.indent + "    " + g.d1("Unknown version '" + ans + "'. Keeping current.")
					end if
				end if
			end if

			if target == null then
				skipped += 1
				continue
			end if
		else
			target = archivedVersions[0]
		end if

		if currentVer != null and target.version == currentVer then
			print g.const.indent + g.d1(libName + " already at v" + currentVer + ", skipping.")
			skipped += 1
			continue
		end if

		srcPath = g.const.SHINYLIBS_BIN_PATH + "/" + libName + "/" + target.version + "/" + libName
		result = g.func.transfer(home.shell, srcPath, context.shell, "/lib")
		if not result then
			print g.error("shinylibs harden: transfer failed for " + libName)
			continue
		end if

		replaced += 1
		print g.const.indent + g.g1("Replaced " + libName + " with v" + target.version)
	end for

	print g.const.nl + g.const.indent + g.s3("Hardened " + replaced + " libraries, skipped " + skipped + ".")
	if replaced > 0 then
		print g.const.indent + g.y1("Warning: SCP creates logs on the target. Run 'corruptlogs' or 'log clear' to clean up.")
	end if
end function

// **shinylibs info (one):**
// Lists every known exploit for a library version. If no version is supplied,
// every known version of the library is shown.
// @param {list<string>} args - Command arguments.
// @return {none}
shinylibsInfoOne = function(args)
	if args.len == 0 or args[0] == "-h" or args[0] == "help" then
		print g.error("shinylibs info: specify a library name and optionally a version.")
		self.help
		return
	end if

	libName = args[0]
	if libName[-3:] != ".so" then libName = libName + ".so"

	archive = g.func.loadShinylibsDb

	if args.len > 1 then
		ver = args[1]
		print g.const.nl + g.func.heading(libName + " " + ver)
		shinylibsPrintVersionInfo(libName, ver, archive, g.s2("Version:"), g.const.indent, "  ")
	else
		versions = {}
		if g.database.hasIndex(libName) and g.database[libName] isa map then
			for ver in g.database[libName].indexes
				versions[ver] = 1
			end for
		end if
		for key in archive.records.indexes
			parts = key.split("/")
			if parts.len < 2 or parts[0] != libName then continue
			versions[parts[1]] = 1
		end for

		if versions.len == 0 then
			print g.error("shinylibs info: no known versions for " + libName)
			return
		end if

		versionList = versions.indexes
		versionList.sort

		print g.const.nl + g.func.heading(libName)
		for ver in versionList
			shinylibsPrintVersionInfo(libName, ver, archive, g.s2("Version:"), g.const.indent, "  ")
		end for
	end if

	print ""
end function

// **shinylibs info:**
// With no arguments, lists the entire ShinyLibs archive and most useful exploits.
// With a library name (and optional version), lists every known exploit for it.
// @param {list<string>} args - Command arguments.
// @return {none}
shinylibsInfo = function(args)
	if args.len == 0 then
		shinylibsInfoAll
	else
		shinylibsInfoOne(args)
	end if
end function

// Picks a sensible extra argument for testing an exploit on the home computer.
// @param {map} record - The exploit record.
// @param {computer} homeComputer - The home computer object.
// @return {string} - The extra argument to pass to overflow.
shinylibsGetTestExtraArg = function(record, homeComputer)
	if record.extraArg == null or record.extraArg == "none" then return ""
	if record.extraArg == "lanIp" then return homeComputer.local_ip
	if record.extraArg == "password" then return ""
	if record.extraArg == "path" then
		if record.requirements != null and record.requirements.hasIndex("requiredPaths") and record.requirements.requiredPaths != null and record.requirements.requiredPaths isa list and record.requirements.requiredPaths.len > 0 then
			return record.requirements.requiredPaths[0]
		end if
		return "/lib"
	end if
	return ""
end function

// Stages an archived library version to /lib on the home computer for testing.
// If /lib already has the target version, no changes are made. Otherwise the
// existing file is backed up to /root/hex-shinylibs/.backup/ and replaced.
// @param {string} libName - Library name.
// @param {string} ver - Library version.
// @param {map} home - Home context map.
// @param {map} archive - Loaded shinylibs archive.
// @return {map} - {success: 1|0, backupPath: string|null, wasChanged: 1|0}
shinylibsStageTestLib = function(libName, ver, home, archive)
	info = {"success": 0, "backupPath": null, "wasChanged": 0}

	libPath = "/lib/" + libName
	srcPath = g.const.SHINYLIBS_BIN_PATH + "/" + libName + "/" + ver + "/" + libName

	existing = home.computer.File(libPath)
	if existing then
		metaLib = home.metax.load(libPath)
		if metaLib != null and metaLib.version == ver then
			info.success = 1
			return info
		end if
	end if

	backupDir = "/root/hex-shinylibs/.backup"
	if not g.func.ensureShinylibsDir(backupDir) then return info

	backupPath = backupDir + "/" + libName
	stale = home.computer.File(backupPath)
	if stale then stale.delete

	if existing then
		moveResult = existing.move(backupDir, libName)
		if moveResult != 1 then
			print g.error("shinylibs test: failed to backup existing " + libName + ": " + moveResult)
			return info
		end if
		info.backupPath = backupPath
	end if

	if not g.func.transfer(home.shell, srcPath, home.shell, "/lib") then
		if info.backupPath != null then
			backupFile = home.computer.File(info.backupPath)
			if backupFile then backupFile.move("/lib", libName)
		end if
		print g.error("shinylibs test: failed to stage " + libName + " v" + ver + " to /lib")
		return info
	end if

	info.success = 1
	info.wasChanged = 1
	return info
end function

// Restores the original /lib library after testing.
// Only makes changes if the staging function actually modified /lib.
// @param {string} libName - Library name.
// @param {map} home - Home context map.
// @param {string|null} backupPath - Path to the backed-up original, or null.
// @param {number} wasChanged - 1 if /lib was modified during staging, 0 otherwise.
// @return {none}
shinylibsRestoreTestLib = function(libName, home, backupPath, wasChanged)
	if wasChanged != 1 then return

	libPath = "/lib/" + libName
	testFile = home.computer.File(libPath)
	if testFile then testFile.delete

	if backupPath != null then
		backupFile = home.computer.File(backupPath)
		if backupFile then
			moveResult = backupFile.move("/lib", libName)
			if moveResult != 1 then
				print g.error("shinylibs test: failed to restore original " + libName + ": " + moveResult)
			end if
		end if
	end if
end function

// Runs a single exploit against a loaded metaLib and records the result.
// @param {metaLib} metaLib - The loaded meta library.
// @param {string} mem - Memory address.
// @param {string} value - Overflow value.
// @param {string} extra - Extra argument for overflow.
// @param {map} record - The exploit record to update.
// @return {string} - The result type, or "null" if no handle was granted.
shinylibsTestExploit = function(metaLib, mem, value, extra, record)
	print g.const.indent + g.s3("Testing " + metaLib.lib_name + " v" + metaLib.version + " @ " + mem + "=" + value + "...")

	temp = metaLib.overflow(mem, value, extra)
	output = ""
	resultType = "null"
	resultUser = null

	if temp == null then
		resultType = "null"
		output = ""
	else if typeof(temp) == "string" then
		resultType = "null"
		output = temp
		temp = null
	else
		rawType = typeof(temp)
		if rawType == "number" then
			if extra == "" and temp == 1 then
				resultType = "firewall"
			else
				resultType = "null"
				output = "number result: " + temp
			end if
		else if rawType == "shell" or rawType == "computer" or rawType == "file" then
			resultType = rawType
			resultUser = g.func.normalizeResultUser(temp.getUser(1))
		else
			resultType = "null"
			output = "unexpected type: " + rawType
		end if
	end if

	if resultType != "null" then
		userText = ""
		if resultUser != null then userText = " (User: " + resultUser + ")"
		print g.const.indent + g.g1("  -> " + resultType + userText)
	end if

	record.tested = 1
	record.lastOutput = output
	if resultType != "null" then
		record.resultType = resultType
		record.resultUser = resultUser
	end if
	g.func.setExploitRecord(metaLib.lib_name, metaLib.version, mem, value, record)

	return resultType
end function

// **shinylibs test:**
// Temporarily stages an archived library version to /lib on the home computer,
// attempts every known exploit so the granted handle is recorded in the exploit DB,
// then restores the original /lib file. If no version is given, every archived
// version of the library is tested. Exploits already marked as tested are skipped.
// @param {list<string>} args - Command arguments.
// @return {none}
shinylibsTest = function(args)
	if args.len < 1 or args[0] == "-h" or args[0] == "help" then
		print g.error("shinylibs test: specify a library name and optionally a version.")
		self.help
		return
	end if

	libName = args[0]
	if libName[-3:] != ".so" then libName = libName + ".so"

	if not g.func.checkShell("0") then return
	if not g.func.checkMetax("0", 1) then
		g.func.attach_metax("0")
	end if
	if not g.func.checkMetax("0") then
		print g.error("shinylibs test: metaxploit not attached on home context.")
		return
	end if

	archive = g.func.loadShinylibsDb

	versions = []
	if args.len > 1 then
		versions.push(args[1])
	else
		for key in archive.records.indexes
			parts = key.split("/")
			if parts.len < 2 or parts[0] != libName then continue
			versions.push(parts[1])
		end for
		versions.sort
	end if

	if versions.len == 0 then
		print g.error("shinylibs test: no archived versions for " + libName)
		return
	end if

	home = g.stack["0"]
	totalTested = 0
	totalSuccess = 0

	for ver in versions
		if not g.database.hasIndex(libName) or not g.database[libName].hasIndex(ver) then
			print g.error("shinylibs test: no database entries for " + libName + " v" + ver + ", skipping.")
			continue
		end if

		archiveKey = libName + "/" + ver
		if not archive.records.hasIndex(archiveKey) then
			print g.error("shinylibs test: " + libName + " v" + ver + " is not in the shinylibs archive. Run 'shinylibs get' first.")
			continue
		end if

		stageInfo = shinylibsStageTestLib(libName, ver, home, archive)
		if not stageInfo.success then continue

		libPath = "/lib/" + libName
		metaLib = home.metax.load(libPath)
		if not metaLib then
			print g.error("shinylibs test: could not load " + libPath + " with metaxploit.")
			shinylibsRestoreTestLib(libName, home, stageInfo.backupPath, stageInfo.wasChanged)
			continue
		end if

		print g.const.nl + g.func.heading("Testing " + libName + " v" + ver)
		print g.const.indent + g.s3("Loaded from " + libPath)

		tested = 0
		success = 0

		mems = g.database[libName][ver].indexes
		for mem in mems
			values = g.database[libName][ver][mem].indexes
			for value in values
				record = g.func.getExploitRecord(libName, ver, mem, value)
				if record.tested == 1 then continue
				extra = shinylibsGetTestExtraArg(record, home.computer)
				resType = shinylibsTestExploit(metaLib, mem, value, extra, record)
				tested += 1
				if resType != "null" then success += 1
			end for
		end for

		shinylibsRestoreTestLib(libName, home, stageInfo.backupPath, stageInfo.wasChanged)

		totalTested += tested
		totalSuccess += success
		print g.const.indent + g.s3("Tested " + tested + " new exploits, " + success + " granted a handle.")
	end for

	g.func.saveExploitDb

	print g.const.nl + g.const.indent + g.s3("Total: tested " + totalTested + " new exploits, " + totalSuccess + " granted a handle.")
end function

// **shinylibs migrate:**
// Migrates legacy exploit database keys to their current names.
// Currently moves requirements.missingLib to requirements.requiredLib in both
// the exploit DB and the shinylibs archive.
// @return {none}
shinylibsMigrate = function
	print g.const.nl + g.func.heading("Migrating exploit database")

	result = g.func.migrateExploitDb
	print g.const.indent + g.s3("Migrated " + result.changed + " exploit record(s).")
	print g.const.indent + g.s3("Migrated " + result.archiveChanged + " archive record(s).")

	if result.changed > 0 or result.archiveChanged > 0 then
		print g.const.indent + g.g1("Migration saved.")
	else
		print g.const.indent + g.d1("No legacy keys found; nothing to migrate.")
	end if

	print ""
end function

// Dispatcher for the shinylibs tool.
// @param {list<string>} args - Command arguments.
// @return {none}
doShinylibs = function(args)
	if not args or args == [] or args[0] == "-h" or args[0] == "help" then
		self.help
		return 
	end if

	sub = args[0]

	if sub == "scan" then
		scanPath = "/lib"
		force = 0
		if args.len > 1 then
			for i in range(1, args.len - 1)
				arg = args[i]
				if arg == "force" then
					force = 1
				else
					scanPath = arg
				end if
			end for
		end if
		shinylibsScan scanPath, force
	else if sub == "info" then
		if args.len > 1 and args[1] == "clear-unhandled" then
			g.func.clearUnhandledRequirements
			return 
		end if
		shinylibsInfo args[1:]
	else if sub == "req-patterns" then
		shinylibsReqPatterns
	else if sub == "get" then
		shinylibsGet
	else if sub == "put" then
		if args.len < 2 then
			print g.error("shinylibs put: specify 'vuln' or 'harden'.")
			self.help
			return 
		end if
		shinylibsPut args[1]
	else if sub == "harden" then
		useDefaults = 0
		if args.len > 1 and args[1] == "defaults" then useDefaults = 1
		shinylibsHarden useDefaults
	else if sub == "test" then
		shinylibsTest args[1:]
	else if sub == "migrate" then
		shinylibsMigrate
	else
		print g.error("shinylibs: unknown subcommand '" + sub + "'.")
		self.help
	end if
end function

g.tools.shinylibs = {
	"name": "shinylibs",
	"shortDescription": "Score, collect, and deploy library binaries.",
	"exec": @doShinylibs,
	"help": @shinylibsHelp,
	"data": {},
}
