// -- Here's some example code that shows a simple remote exploit loop.

print "Hello World"
metax = include_lib("/lib/metaxploit.so")
requirements = {}

for i in range(100)
	getRandomIp = function
		router = null

		while not router
			addr = ""

			while addr.split("\.").len < 4
				seg = floor(rnd * 256)
				if addr != "" then addr += "."
				addr += seg
			end while

			if not is_valid_ip(addr) or is_lan_ip(addr) then continue

			router = get_router(addr)
		end while

		return router.public_ip
	end function

	ip = getRandomIp
	ports = get_router(ip).used_ports

	for port in ports
		if port.is_closed then continue
		print ip + ":" + port.port_number

		netSession = metax.net_use(ip, port.port_number)
		if netSession == null then continue

		metaLib = netSession.dump_lib
		print "Library: " + metaLib.lib_name + " - " + metaLib.version + " on port " + port.port_number
		addresses = metax.scan(metaLib)

		for address in addresses
			print "metaLib: " + metaLib + " address: " + address
			output = metax.scan_address(metaLib, address)

			if output == null then
				print "Something went wrong attempting to scan this address: " + address
				continue
			end if

			// -- print the vulnerabilities just to satisfy curiosity
			print output

			// -- split on the string "Unsafe check: " because it is a good delimiter between one vulnerability and the next
			// -- split gives us an array of strings.  slice the array with [1:] to skip the first item.
			lines = output.split(char(10))

			for line in lines
				if line == null or line == "" then continue
				// Looking for requirements lines which begin with *
				if line[0] == "*" then
					requirements.push line
				end if
			end for
		end for
	end for

	print "Requirements:" + char(10) + requirements
end for